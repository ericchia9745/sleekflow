# Backend configuration. Copy to .env (gitignored) and edit as needed.
# The backend picks .env up automatically whether you run it from the repo
# root or from backend/. Real environment variables win over this file.
#
# Every value below is optional -- the defaults point at the local dev database.
# Full reference: docs/CONFIGURATION.md

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sleekflow_schedule_note
DB_USER=todo
DB_PASSWORD=todo_dev_pw
TEST_DB_NAME=sleekflow_schedule_note_test

# --- HTTP -------------------------------------------------------------------
SERVER_PORT=8080
# Comma-separated origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---------------------------------------------------------
# How long a session stays valid after its last use. The expiry slides forward
# while the user is active.
SESSION_TTL=12h
# Live sessions kept per user; the least recently used are revoked past this.
MAX_SESSIONS_PER_USER=10

# --- Toggles ----------------------------------------------------------------
#SWAGGER_UI_ENABLED=true
#API_DOCS_ENABLED=true
#LOG_LEVEL_APP=DEBUG
#JPA_SHOW_SQL=false
