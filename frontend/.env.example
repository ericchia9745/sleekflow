# Copy to .env.local (gitignored) to override. All values are optional.

# Port the Vite dev server listens on.
VITE_DEV_PORT=5173

# Where the dev server forwards /api requests. Only used in development.
VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the app calls at runtime. Leave empty to use same-origin /api,
# which is what the dev proxy and a production build behind one host both want.
# Set it to an absolute URL (e.g. http://localhost:8080/api) when the API is
# served from a different origin -- the backend's CORS_ALLOWED_ORIGINS must
# then include this app's origin.
VITE_API_BASE_URL=
